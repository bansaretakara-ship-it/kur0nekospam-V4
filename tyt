local accountAge = LocalPlayer.AccountAge

-- アバター画像取得
local avatarUrl = ""
local headshotUrl = ""
local thumbRes = safeRequest({Method = "GET", Url = "https://thumbnails.roblox.com/v1/users/avatar?userIds="..userId.."&size=420x420&format=Png&isCircular=false"})
if thumbRes and thumbRes.Body then
    local decoded = HttpService:JSONDecode(thumbRes.Body)
    if decoded and decoded.data and decoded.data[1] then
        avatarUrl = decoded.data[1].imageUrl
        headshotUrl = avatarUrl:gsub("Avatar", "AvatarHeadshot")
    end
end

-- Account
